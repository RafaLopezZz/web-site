---
interface Props {
  locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const navigationLabel = locale === "en" ? "Footer navigation" : "Navegación del pie";
const contactHref = locale === "en" ? `${base}en/contact/` : `${base}contact/`;
const contactLabel = locale === "en" ? "Contact" : "Contacto";
---

<footer class="site-footer py-8 md:py-10">
  <div
    class="site-footer__content rlp-container flex flex-col gap-4 text-sm md:flex-row md:items-center md:justify-between"
  >
    <p>Rafael López · Software Developer</p>
    <nav class="site-footer__links flex flex-wrap gap-x-4 gap-y-2" aria-label={navigationLabel}>
      <a href="mailto:rlp.murcia@gmail.com" class="transition"
        >Email</a
      >
      <a href={contactHref} class="transition">{contactLabel}</a>
      <a
        href="https://github.com/RafaLopezZz"
        target="_blank"
        rel="noreferrer"
        class="transition">GitHub</a
      >
      <a
        href="https://www.linkedin.com/in/rafalopezzz/"
        target="_blank"
        rel="noreferrer"
        class="transition">LinkedIn</a
      >
      <a
        href={`${base}cv/lopez-plana-rafael-2026.pdf`}
        target="_blank"
        rel="noreferrer"
        class="transition">CV</a
      >
    </nav>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--theme-line); }
  .site-footer__content { color: var(--theme-text-muted); }
  .site-footer__links { color: var(--theme-text); }
  .site-footer__links a:hover { color: var(--theme-accent); }
</style>
