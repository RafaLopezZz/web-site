---
interface Props {
  locale: "es" | "en";
  territory: "work" | "production";
}

const { locale, territory } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const href = locale === "en" ? `${base}en/${territory}/` : `${base}${territory}/`;
const label = locale === "en"
  ? territory === "production" ? "← Back to Production" : "← Back to Work"
  : territory === "production" ? "← Volver a Producción" : "← Volver a Trabajo";
---

<a class="case-back-link" href={href}>{label}</a>
