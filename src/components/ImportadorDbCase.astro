---
import ActionLink from "./ActionLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { importadorDbCase } from "../data/importador-db-case";
const { locale } = Astro.props as { locale: "es" | "en" };
const copy = importadorDbCase[locale];
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title={`${copy.title} | Rafael López`} description={copy.description} lang={locale}><SiteHeader locale={locale} /><main id="main-content" class="case-shell"><article class="case rlp-container" data-importador-case><header class="case__hero"><p>{copy.eyebrow}</p><h1>{copy.title}</h1><p>{copy.subtitle}</p><p class="case__stack">{copy.stack}</p></header><section><h2>{copy.contextTitle}</h2><p>{copy.context}</p></section><section><h2>{copy.engineeringTitle}</h2><div class="case__decisions">{copy.decisions.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></section><section><h2>{copy.evidenceTitle}</h2><ul>{copy.evidence.map((item) => <li>{item}</li>)}</ul></section><section><h2>{copy.outcomeTitle}</h2><p>{copy.outcome}</p></section><nav class="case__actions" aria-label={locale === "es" ? "Fuentes del caso" : "Case sources"}><ActionLink variant="primary" href="https://github.com/RafaLopezZz/importador-db" target="_blank" rel="noreferrer">{copy.source}</ActionLink><ActionLink href={`${base}blog/desarrollo-importador-db/`}>{copy.blog}</ActionLink></nav></article></main><SiteFooter locale={locale} /></BaseLayout>
<style>.case-shell{background:var(--theme-canvas);color:var(--theme-text)}.case{display:grid;gap:var(--space-8);padding-block:var(--space-8)}.case__hero,section{display:grid;gap:var(--space-4);max-width:var(--reading-max)}.case__hero>p,section>p,li{margin:0;color:var(--theme-text-muted);line-height:1.7}.case__hero>p:first-child,.case__stack{font-family:var(--font-mono);font-size:.8rem;letter-spacing:.08em}.case__hero>p:first-child{color:var(--theme-accent)}h1,h2,h3{margin:0;font-family:var(--font-sans);line-height:1.1}h1{font-size:clamp(2.75rem,7vw,5.5rem)}h2{font-size:clamp(1.75rem,4vw,2.5rem)}h3{font-size:1.1rem}.case__decisions{display:grid;gap:var(--space-4)}.case__decisions article{border-left:2px solid var(--theme-accent);padding-left:var(--space-4)}.case__decisions p{margin:.5rem 0 0;color:var(--theme-text-muted);line-height:1.6}ul{display:grid;gap:var(--space-3);margin:0;padding-left:1.2rem}.case__actions{display:flex;flex-wrap:wrap;gap:var(--space-4)}</style>
