---
import ActionLink from "./ActionLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import Surface from "./Surface.astro";
import type { ProductionCaseCopy } from "../data/quinta-bella-case";

interface Props {
  locale: "es" | "en";
  caseId: string;
  copy: ProductionCaseCopy;
  repositoryHref: string;
  publicSiteHref: string;
}

const { locale, caseId, copy, repositoryHref, publicSiteHref } = Astro.props;
---

<BaseLayout title={`${copy.title} | Rafael López`} description={copy.description} lang={locale}>
  <SiteHeader locale={locale} />

  <main id="main-content" class="production-case-shell">
    <Surface variant="dossier" class="production-case rlp-container" data-production-case={caseId}>
      <header class="production-case__hero">
        <p>{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p>{copy.subtitle}</p>
        <p class="production-case__stack">{copy.stack}</p>
      </header>

      <div class="production-case__body">
        {copy.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))}
      </div>

      <nav class="production-case__actions" aria-label={copy.sourcesTitle}>
        <ActionLink variant="primary" href={repositoryHref} target="_blank" rel="noreferrer">{copy.repository}</ActionLink>
        <ActionLink href={publicSiteHref} target="_blank" rel="noreferrer">{copy.publicSite}</ActionLink>
      </nav>
    </Surface>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .production-case-shell { background: var(--theme-canvas); color: var(--theme-text); }
  .production-case { display: grid; gap: var(--space-7); margin-block: var(--space-8); padding-block: var(--space-6); }
  .production-case__hero, .production-case__body section { display: grid; gap: var(--space-4); max-width: var(--reading-max); }
  .production-case__hero > p, .production-case__body p { margin: 0; color: var(--theme-text-muted); line-height: 1.7; }
  .production-case__hero > p:first-child, .production-case__stack { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.08em; }
  .production-case__hero > p:first-child { color: var(--theme-accent); }
  h1, h2 { margin: 0; font-family: var(--font-sans); line-height: 1.1; }
  h1 { font-size: clamp(2.75rem, 7vw, 5.5rem); }
  h2 { font-size: clamp(1.75rem, 4vw, 2.5rem); }
  .production-case__body { display: grid; gap: var(--space-7); }
  .production-case__actions { display: flex; flex-wrap: wrap; gap: var(--space-4); }

  @media (min-width: 1024px) {
    .production-case { margin-block: var(--space-9); padding: var(--space-7); }
    .production-case__body { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
    .production-case__body section { max-width: none; }
  }
</style>
