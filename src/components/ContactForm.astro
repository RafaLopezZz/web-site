---
import { ENV } from "../config/env";
import BaseLayout from "../layouts/BaseLayout.astro";
import Action from "./Action.astro";
import ActionLink from "./ActionLink.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  locale: "es" | "en";
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const copy = locale === "en"
  ? {
      title: "Contact | Rafael López",
      description: "Contact Rafael López about concrete software work.",
      eyebrow: "RLP / CONTACT",
      heading: "Contact",
      intro: "If you want to talk about software, projects, automation, or an idea I could contribute to, I would be glad to hear from you.",
      contextTitle: "Let's talk",
      context: "Do you have a project, an idea, or a question? Write to me and tell me a little about it. No special preparation is needed.",
      directLabel: "You can also find me here",
      directText: "If you prefer to write directly or connect another way:",
      formTitle: "Write to me",
      formIntro: "Tell me what you need.",
      name: "Name",
      email: "Email",
      subject: "Subject",
      message: "Message",
      captchaLabel: "Security check",
      submit: "Send message",
      retry: "Try again",
      errors: {
        nameRequired: "Enter your name.",
        emailRequired: "Enter your email.",
        emailInvalid: "Enter a valid email.",
        subjectTooLong: "Subject must be 150 characters or fewer.",
        nameTooLong: "Name must be 100 characters or fewer.",
        emailTooLong: "Email must be 150 characters or fewer.",
        messageRequired: "Enter a message.",
        messageTooLong: "Message must be 2,000 characters or fewer.",
        validation: "Check the highlighted fields.",
        captchaMissing: "Complete the CAPTCHA before sending the form.",
        captchaExpired: "The CAPTCHA has expired. Complete it again.",
        captchaError: "CAPTCHA validation failed. Try again.",
        reset: "The CAPTCHA could not be reset. Try again or use email.",
      },
      status: {
        idle: "Ready to send.",
        validating: "Checking the form…",
        captcha: "Complete the CAPTCHA to continue.",
        captchaReady: "CAPTCHA verified. You can send the message.",
        submitting: "Sending…",
        success: "Message sent successfully. Thanks for writing.",
        error: "The message could not be sent. Try again or email rlp.murcia@gmail.com.",
        sent: "Message sent",
      },
      links: {
        email: "Email",
        github: "GitHub",
        linkedin: "LinkedIn",
      },
    }
  : {
      title: "Contacto | Rafael López",
      description: "Contacta con Rafael López para hablar de trabajo de software concreto.",
      eyebrow: "RLP / CONTACT",
      heading: "Contacto",
      intro: "Si quieres hablar sobre software, proyectos, automatización o alguna idea en la que pueda ayudar, estaré encantado de leerte.",
      contextTitle: "Hablemos",
      context: "¿Tienes un proyecto, una idea o una pregunta? Escríbeme y cuéntame un poco. No hace falta preparar nada especial.",
      directLabel: "También puedes encontrarme aquí",
      directText: "Si prefieres escribirme directamente o conectar por otra vía:",
      formTitle: "Escríbeme",
      formIntro: "Cuéntame lo que necesites.",
      name: "Nombre",
      email: "Email",
      subject: "Asunto",
      message: "Mensaje",
      captchaLabel: "Comprobación de seguridad",
      submit: "Enviar mensaje",
      retry: "Reintentar",
      errors: {
        nameRequired: "Escribe tu nombre.",
        emailRequired: "Escribe tu email.",
        emailInvalid: "Introduce un email válido.",
        subjectTooLong: "El asunto debe tener 150 caracteres o menos.",
        nameTooLong: "El nombre debe tener 100 caracteres o menos.",
        emailTooLong: "El email debe tener 150 caracteres o menos.",
        messageRequired: "Escribe un mensaje.",
        messageTooLong: "El mensaje debe tener 2.000 caracteres o menos.",
        validation: "Revisa los campos señalados.",
        captchaMissing: "Completa el CAPTCHA antes de enviar el formulario.",
        captchaExpired: "El CAPTCHA ha caducado. Complétalo de nuevo.",
        captchaError: "La validación del CAPTCHA falló. Inténtalo de nuevo.",
        reset: "No se pudo reiniciar el CAPTCHA. Inténtalo de nuevo o usa el email.",
      },
      status: {
        idle: "Listo para enviar.",
        validating: "Comprobando el formulario…",
        captcha: "Completa el CAPTCHA para continuar.",
        captchaReady: "CAPTCHA validado. Ya puedes enviar el mensaje.",
        submitting: "Enviando…",
        success: "Mensaje enviado correctamente. Gracias por escribirme.",
        error: "No se pudo enviar el mensaje. Inténtalo de nuevo o escribe a rlp.murcia@gmail.com.",
        sent: "Mensaje enviado",
      },
      links: {
        email: "Email",
        github: "GitHub",
        linkedin: "LinkedIn",
      },
    };
---

<BaseLayout title={copy.title} description={copy.description} lang={locale}>
  <SiteHeader locale={locale} />

  <main id="main-content" class="contact-shell">
    <section class="contact-page rlp-container" aria-labelledby="contact-title">
      <header class="contact-page__header">
        <p class="contact-page__eyebrow">{copy.eyebrow}</p>
        <h1 id="contact-title">{copy.heading}</h1>
        <p>{copy.intro}</p>
      </header>

      <div class="contact-page__layout">
        <section class="contact-page__context" aria-labelledby="contact-context-title">
          <h2 id="contact-context-title">{copy.contextTitle}</h2>
          <p>{copy.context}</p>
          <div class="contact-page__direct">
            <p class="contact-page__kicker">{copy.directLabel}</p>
            <p>{copy.directText} <a href="mailto:rlp.murcia@gmail.com">rlp.murcia@gmail.com</a></p>
          </div>
          <div class="contact-page__links" aria-label={locale === "en" ? "Direct contact links" : "Enlaces de contacto directo"}>
            <ActionLink href="mailto:rlp.murcia@gmail.com" variant="secondary">{copy.links.email}</ActionLink>
            <ActionLink href="https://github.com/RafaLopezZz" target="_blank" rel="noreferrer" variant="secondary">{copy.links.github}</ActionLink>
            <ActionLink href="https://www.linkedin.com/in/rafalopezzz/" target="_blank" rel="noreferrer" variant="secondary">{copy.links.linkedin}</ActionLink>
          </div>
        </section>

        <section class="contact-surface" aria-labelledby="contact-form-title">
          <div class="contact-surface__heading">
            <h2 id="contact-form-title">{copy.formTitle}</h2>
            <p>{copy.formIntro}</p>
          </div>

          <form
            id="contact-form"
            class="contact-form"
            data-contact-locale={locale}
            data-contact-state="IDLE"
            data-web3forms-key={ENV.WEB3FORMS_KEY}
            aria-busy="false"
            novalidate
          >
            <div class="contact-form__fields">
              <div class="contact-field contact-field--required">
                <label for="name">{copy.name}</label>
                <input id="name" name="name" maxlength="100" autocomplete="name" required aria-required="true" aria-describedby="name-error" />
                <p id="name-error" class="contact-field__error" role="alert"></p>
              </div>

              <div class="contact-field contact-field--required">
                <label for="email">{copy.email}</label>
                <input id="email" name="email" type="email" maxlength="150" autocomplete="email" required aria-required="true" aria-describedby="email-error" />
                <p id="email-error" class="contact-field__error" role="alert"></p>
              </div>

              <div class="contact-field contact-field--full">
                <label for="contact-subject"><span>{copy.subject}</span></label>
                <input id="contact-subject" name="subject" maxlength="150" autocomplete="off" aria-describedby="subject-error" />
                <p id="subject-error" class="contact-field__error" role="alert"></p>
              </div>

              <div class="contact-field contact-field--full contact-field--required">
                <label for="message">{copy.message}</label>
                <textarea id="message" name="message" maxlength="2000" rows="7" autocomplete="off" required aria-required="true" aria-describedby="message-error"></textarea>
                <p id="message-error" class="contact-field__error" role="alert"></p>
              </div>
            </div>

            <div class="contact-captcha" role="group" aria-labelledby="contact-captcha-label">
              <p id="contact-captcha-label">{copy.captchaLabel}</p>
              <h-captcha id="contact-hcaptcha" site-key={ENV.HCAPTCHA_SITEKEY} theme="light" tabindex="0"></h-captcha>
              <p id="contact-captcha-error" class="contact-form__captcha-error" role="alert" aria-live="polite"></p>
            </div>

            <div class="contact-form__actions">
              <Action id="contact-submit" type="submit">{copy.submit}</Action>
              <button id="contact-retry" class="action action--secondary contact-form__retry" type="button" hidden>{copy.retry}</button>
              <p id="contact-status" class="contact-form__status" data-state="IDLE" role="status" aria-live="polite" tabindex="-1">{copy.status.idle}</p>
            </div>
          </form>
        </section>
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .contact-page {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-9);
  }

  .contact-page__header,
  .contact-page__context,
  .contact-surface__heading {
    display: grid;
    gap: var(--space-3);
  }

  .contact-page__header {
    max-width: var(--reading-max);
  }

  .contact-page__eyebrow,
  .contact-page__kicker,
  .contact-captcha > p:first-child {
    margin: 0;
    color: var(--theme-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-page__eyebrow,
  .contact-page__kicker {
    color: var(--theme-accent);
  }

  .contact-page__header h1,
  .contact-page__context h2,
  .contact-surface h2 {
    margin: 0;
    font-family: var(--font-sans);
    line-height: 1.05;
  }

  .contact-page__header h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
  }

  .contact-page__header > p:last-child,
  .contact-page__context > p,
  .contact-page__direct p:last-child,
  .contact-surface__heading > p:last-child {
    margin: 0;
    color: var(--theme-text-muted);
    line-height: 1.65;
  }

  .contact-page__layout {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .contact-page__context {
    max-width: var(--reading-max);
  }

  .contact-page__context h2 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }

  .contact-page__direct {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--theme-line);
  }

  .contact-page a:not(.action) {
    color: var(--theme-text);
    text-decoration: underline;
    text-decoration-color: var(--theme-accent);
    text-underline-offset: 0.25em;
  }

  .contact-page a:not(.action):hover {
    color: var(--theme-accent);
  }

  .contact-page__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-3);
  }

  .contact-surface {
    display: grid;
    gap: var(--space-6);
    border: 1px solid var(--theme-line);
    border-left: 3px solid var(--theme-accent);
    padding: var(--space-5);
    background: var(--theme-surface-raised);
  }

  .contact-surface h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .contact-form {
    display: grid;
    gap: var(--space-6);
  }

  .contact-form__fields {
    display: grid;
    gap: var(--space-4);
  }

  .contact-field {
    display: grid;
    gap: var(--space-2);
  }

  .contact-field label {
    color: var(--theme-text);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .contact-field--required label::after {
    content: " *";
    color: var(--theme-accent);
  }

  .contact-field input,
  .contact-field textarea {
    width: 100%;
    border: 1px solid var(--theme-line);
    padding: 0.75rem 0.875rem;
    background: var(--theme-surface);
    color: var(--theme-text);
    font: inherit;
    line-height: 1.45;
  }

  .contact-field textarea {
    min-height: 11rem;
    resize: vertical;
  }

  .contact-field input:focus,
  .contact-field textarea:focus {
    border-color: var(--theme-accent);
  }

  .contact-field input[aria-invalid="true"],
  .contact-field textarea[aria-invalid="true"] {
    border-color: var(--theme-text);
    box-shadow: inset 3px 0 0 var(--theme-accent);
  }

  .contact-field__error,
  .contact-form__captcha-error {
    min-height: 1.25rem;
    margin: 0;
    color: var(--theme-text);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .contact-field__error:not(:empty)::before,
  .contact-form__captcha-error:not(:empty)::before {
    content: "! ";
    color: var(--theme-accent);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .contact-captcha {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block: 1px solid var(--theme-line);
  }

  .contact-captcha h-captcha {
    min-height: 5rem;
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .contact-form__status {
    flex: 1 1 16rem;
    min-width: 12rem;
    margin: 0;
    color: var(--theme-text-muted);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .contact-form__status[data-state="SUCCESS"] {
    color: var(--theme-text);
    font-weight: 600;
  }

  .contact-form__status[data-state="ERROR"] {
    color: var(--theme-text);
    font-weight: 600;
  }

  .contact-form__status:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 0.25rem;
  }

  @media (min-width: 768px) {
    .contact-page__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(28rem, 1.15fr);
      gap: var(--space-8);
    }

    .contact-form__fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-4);
    }

    .contact-field--full {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .contact-page {
      padding-block: var(--space-9);
    }

    .contact-surface {
      padding: var(--space-6);
    }
  }
</style>

<script>
  import "@hcaptcha/vanilla-hcaptcha";

  type ContactState = "IDLE" | "VALIDATING" | "CAPTCHA" | "SUBMITTING" | "SUCCESS" | "ERROR";
  type FieldName = "name" | "email" | "subject" | "message";
  type FieldElement = HTMLInputElement | HTMLTextAreaElement;
  type ContactValues = Record<FieldName, string>;
  type ContactErrorCopy = {
    nameRequired: string;
    emailRequired: string;
    emailInvalid: string;
    subjectTooLong: string;
    nameTooLong: string;
    emailTooLong: string;
    messageRequired: string;
    messageTooLong: string;
    validation: string;
    captchaMissing: string;
    captchaExpired: string;
    captchaError: string;
    reset: string;
  };
  type ContactStatusCopy = {
    idle: string;
    validating: string;
    captcha: string;
    captchaReady: string;
    submitting: string;
    success: string;
    error: string;
    sent: string;
  };
  type CaptchaElement = HTMLElement & { reset?: () => void };
  type RecordValue = Record<string, unknown>;

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const submitButton = document.querySelector<HTMLButtonElement>("#contact-submit");
  const retryButton = document.querySelector<HTMLButtonElement>("#contact-retry");
  const status = document.querySelector<HTMLElement>("#contact-status");
  const captchaElement = document.querySelector<CaptchaElement>("#contact-hcaptcha");
  const captchaError = document.querySelector<HTMLElement>("#contact-captcha-error");
  const locale = form?.dataset.contactLocale === "en" ? "en" : "es";
  const limits: Record<FieldName, number> = { name: 100, email: 150, subject: 150, message: 2000 };
  const defaultSubmissionTimeoutMs = 20_000;
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const fields: Record<FieldName, FieldElement | null> = {
    name: document.querySelector<FieldElement>("#name"),
    email: document.querySelector<FieldElement>("#email"),
    subject: document.querySelector<FieldElement>("#contact-subject"),
    message: document.querySelector<FieldElement>("#message"),
  };
  const statusCopy: ContactStatusCopy = locale === "en"
    ? {
        idle: "Ready to send.", validating: "Checking the form…", captcha: "Complete the CAPTCHA to continue.",
        captchaReady: "CAPTCHA verified. You can send the message.", submitting: "Sending…",
        success: "Message sent successfully. Thanks for writing.", error: "The message could not be sent. Try again or email rlp.murcia@gmail.com.", sent: "Message sent",
      }
    : {
        idle: "Listo para enviar.", validating: "Comprobando el formulario…", captcha: "Completa el CAPTCHA para continuar.",
        captchaReady: "CAPTCHA validado. Ya puedes enviar el mensaje.", submitting: "Enviando…",
        success: "Mensaje enviado correctamente. Gracias por escribirme.", error: "No se pudo enviar el mensaje. Inténtalo de nuevo o escribe a rlp.murcia@gmail.com.", sent: "Mensaje enviado",
      };
  const errorCopy: ContactErrorCopy = locale === "en"
    ? {
        nameRequired: "Enter your name.", emailRequired: "Enter your email.", emailInvalid: "Enter a valid email.",
        subjectTooLong: "Subject must be 150 characters or fewer.", nameTooLong: "Name must be 100 characters or fewer.",
        emailTooLong: "Email must be 150 characters or fewer.", messageRequired: "Enter a message.",
        messageTooLong: "Message must be 2,000 characters or fewer.", validation: "Check the highlighted fields.",
        captchaMissing: "Complete the CAPTCHA before sending the form.", captchaExpired: "The CAPTCHA has expired. Complete it again.",
        captchaError: "CAPTCHA validation failed. Try again.", reset: "The CAPTCHA could not be reset. Try again or use email.",
      }
    : {
        nameRequired: "Escribe tu nombre.", emailRequired: "Escribe tu email.", emailInvalid: "Introduce un email válido.",
        subjectTooLong: "El asunto debe tener 150 caracteres o menos.", nameTooLong: "El nombre debe tener 100 caracteres o menos.",
        emailTooLong: "El email debe tener 150 caracteres o menos.", messageRequired: "Escribe un mensaje.",
        messageTooLong: "El mensaje debe tener 2.000 caracteres o menos.", validation: "Revisa los campos señalados.",
        captchaMissing: "Completa el CAPTCHA antes de enviar el formulario.", captchaExpired: "El CAPTCHA ha caducado. Complétalo de nuevo.",
        captchaError: "La validación del CAPTCHA falló. Inténtalo de nuevo.", reset: "No se pudo reiniciar el CAPTCHA. Inténtalo de nuevo o usa el email.",
      };

  const isRecord = (value: unknown): value is RecordValue => typeof value === "object" && value !== null;
  const isBusyState = (state: ContactState) => state === "VALIDATING" || state === "CAPTCHA" || state === "SUBMITTING";

  if (
    form instanceof HTMLFormElement &&
    submitButton instanceof HTMLButtonElement &&
    retryButton instanceof HTMLButtonElement &&
    status instanceof HTMLElement &&
    captchaElement instanceof HTMLElement
  ) {
    let state: ContactState = "IDLE";
    let isSubmitting = false;
    let captchaToken = "";
    let captchaNeedsFreshToken = false;
    let hasAttemptedCaptcha = false;
    const idleSubmitLabel = submitButton.textContent ?? "";

    const syncControls = () => {
      const busy = isBusyState(state);
      form.setAttribute("aria-busy", String(busy));
      submitButton.disabled = busy || state === "SUCCESS";
      retryButton.hidden = state !== "ERROR";
      status.dataset.state = state;
      form.dataset.contactState = state;
      submitButton.textContent = state === "SUBMITTING"
        ? statusCopy.submitting
        : state === "SUCCESS"
          ? statusCopy.sent
          : idleSubmitLabel;
      status.classList.toggle("is-busy", busy);
      status.classList.toggle("is-error", state === "ERROR");
      status.classList.toggle("is-success", state === "SUCCESS");
    };

    const setState = (nextState: ContactState, message: string) => {
      state = nextState;
      status.textContent = message;
      syncControls();
    };

    const setCaptchaMessage = (message = "") => {
      captchaError.textContent = message;
    };

    const setFieldError = (fieldName: FieldName, message = "") => {
      const field = fields[fieldName];
      const error = document.querySelector<HTMLElement>(`#${fieldName === "subject" ? "subject" : fieldName}-error`);
      if (!field || !error) return;
      const hasError = Boolean(message);
      error.textContent = message;
      field.setAttribute("aria-invalid", String(hasError));
      if (hasError) field.setAttribute("aria-describedby", error.id);
      else field.removeAttribute("aria-describedby");
    };

    const clearFieldErrors = () => {
      (Object.keys(fields) as FieldName[]).forEach((fieldName) => setFieldError(fieldName));
    };

    const readValues = (): ContactValues => ({
      name: fields.name?.value.trim() ?? "",
      email: fields.email?.value.trim() ?? "",
      subject: fields.subject?.value.trim() ?? "",
      message: fields.message?.value.trim() ?? "",
    });

    const validateValues = (values: ContactValues) => {
      const invalid: FieldName[] = [];
      if (!values.name) {
        setFieldError("name", errorCopy.nameRequired);
        invalid.push("name");
      } else if (values.name.length > limits.name) {
        setFieldError("name", errorCopy.nameTooLong);
        invalid.push("name");
      }
      if (!values.email) {
        setFieldError("email", errorCopy.emailRequired);
        invalid.push("email");
      } else if (values.email.length > limits.email) {
        setFieldError("email", errorCopy.emailTooLong);
        invalid.push("email");
      } else if (!emailPattern.test(values.email)) {
        setFieldError("email", errorCopy.emailInvalid);
        invalid.push("email");
      }
      if (values.subject.length > limits.subject) {
        setFieldError("subject", errorCopy.subjectTooLong);
        invalid.push("subject");
      }
      if (!values.message) {
        setFieldError("message", errorCopy.messageRequired);
        invalid.push("message");
      } else if (values.message.length > limits.message) {
        setFieldError("message", errorCopy.messageTooLong);
        invalid.push("message");
      }
      return invalid;
    };

    const resetCaptchaSafely = () => {
      captchaToken = "";
      captchaNeedsFreshToken = true;
      try {
        captchaElement.reset?.();
        return true;
      } catch {
        return false;
      }
    };

    const focusElement = (element: HTMLElement | null) => element?.focus({ preventScroll: true });

    const setRecoverableError = (message: string, resetCaptcha = false) => {
      if (resetCaptcha) resetCaptchaSafely();
      setState("ERROR", message);
    };

    const getCaptchaToken = () => {
      if (captchaToken) return captchaToken;
      if (captchaNeedsFreshToken) return "";
      return String(new FormData(form).get("h-captcha-response") ?? "").trim();
    };

    const getSubmissionTimeout = () => {
      // Test seam: a DOM override keeps timeout coverage deterministic without shortening production behavior.
      const configured = Number(form.dataset.contactTimeoutMs);
      return Number.isFinite(configured) && configured > 0 ? configured : defaultSubmissionTimeoutMs;
    };

    const getCaptchaTokenFromEvent = (event: Event) => {
      const detail = event instanceof CustomEvent ? event.detail : undefined;
      const eventToken = isRecord(detail) ? detail.token : undefined;
      const propertyToken = (event as Event & { token?: unknown }).token;
      return typeof eventToken === "string" ? eventToken : typeof propertyToken === "string" ? propertyToken : "";
    };

    captchaElement.addEventListener("verified", (event) => {
      captchaToken = getCaptchaTokenFromEvent(event);
      captchaNeedsFreshToken = false;
      setCaptchaMessage("");
      if (state !== "SUCCESS" && !isSubmitting) setState("IDLE", statusCopy.captchaReady);
    });

    const handleCaptchaFailure = (message: string) => {
      if (isSubmitting || state === "SUCCESS" || captchaToken || !hasAttemptedCaptcha) return;
      captchaToken = "";
      captchaNeedsFreshToken = true;
      setCaptchaMessage(message);
      setRecoverableError(message);
      focusElement(captchaElement);
    };

    captchaElement.addEventListener("expired", () => handleCaptchaFailure(errorCopy.captchaExpired));
    captchaElement.addEventListener("challenge-expired", () => handleCaptchaFailure(errorCopy.captchaExpired));
    captchaElement.addEventListener("error", () => handleCaptchaFailure(errorCopy.captchaError));

    retryButton.addEventListener("click", () => {
      setCaptchaMessage("");
      if (!resetCaptchaSafely()) {
        setRecoverableError(errorCopy.reset);
        focusElement(retryButton);
        return;
      }
      setState("CAPTCHA", statusCopy.captcha);
      focusElement(captchaElement);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (isSubmitting || state === "SUCCESS" || isBusyState(state)) return;

      clearFieldErrors();
      setCaptchaMessage("");
      setState("VALIDATING", statusCopy.validating);
      const values = readValues();
      const invalidFields = validateValues(values);

      if (invalidFields.length) {
        setRecoverableError(errorCopy.validation);
        focusElement(fields[invalidFields[0]]);
        return;
      }

      setState("CAPTCHA", statusCopy.captcha);
      hasAttemptedCaptcha = true;
      const effectiveCaptchaToken = getCaptchaToken();
      if (!effectiveCaptchaToken) {
        setCaptchaMessage(errorCopy.captchaMissing);
        setRecoverableError(errorCopy.captchaMissing);
        focusElement(captchaElement);
        return;
      }

      isSubmitting = true;
      setState("SUBMITTING", statusCopy.submitting);
      const controller = new AbortController();
      const timeoutId = window.setTimeout(() => controller.abort(), getSubmissionTimeout());
      const payload: Record<string, string> = {
        access_key: form.dataset.web3formsKey ?? "",
        from_name: "RLP Portfolio",
        name: values.name,
        email: values.email,
        subject: values.subject,
        message: values.message,
        "h-captcha-response": effectiveCaptchaToken,
      };

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        if (!response.ok) throw new Error("submission-failed");
        const result: unknown = await response.json();
        if (!isRecord(result) || result.success !== true) throw new Error("submission-failed");

        form.reset();
        resetCaptchaSafely();
        setCaptchaMessage("");
        setState("SUCCESS", statusCopy.success);
        status.focus({ preventScroll: true });
      } catch {
        resetCaptchaSafely();
        setCaptchaMessage("");
        setRecoverableError(statusCopy.error, true);
        focusElement(retryButton);
      } finally {
        window.clearTimeout(timeoutId);
        isSubmitting = false;
        if (state === "VALIDATING" || state === "CAPTCHA" || state === "SUBMITTING") {
          setRecoverableError(statusCopy.error, true);
        } else {
          syncControls();
        }
      }
    });

    syncControls();
  }
</script>
