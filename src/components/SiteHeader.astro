---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
interface Props {
  locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;
const home = locale === "en" ? `${base}en/` : base;
const isBlog = locale === "es" && Astro.url.pathname.startsWith(`${base}blog`);
const work = locale === "en" ? `${base}en/work/` : `${base}work/`;
const isWork = Astro.url.pathname === work;

const links = locale === "en" ? [
  { href: home, label: "Home", current: !isWork },
  { href: work, label: "Work", current: isWork },
  { href: `${base}blog/`, label: "Notes" },
] : [
  { href: home, label: "Inicio", current: !isBlog && !isWork },
  { href: work, label: "Trabajo", current: isWork },
  { href: `${base}blog/`, label: "Notas", current: isBlog },
];
---

<header class="site-header">
  <div class="rlp-container">
    <nav class="site-header__nav" aria-label="Primary navigation">
      <a class="site-header__brand" href={home}>RLP</a>

      <div class="site-header__primary">
        <div id="site-navigation" class="site-header__menu" hidden>
          <ul class="site-header__links">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={["site-header__link", link.current && "is-current"]}
                    aria-current={link.current ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="site-header__utility">
        <nav id="locale-control" class="site-header__locale" aria-label="Idioma" data-retro-locale={locale}>
          <a href={base} aria-current={locale === "es" ? "page" : undefined}>ES</a>
          <a href={`${base}en/`} aria-current={locale === "en" ? "page" : undefined}>EN</a>
          <span class="site-header__locale-marker" data-position={locale} aria-hidden="true"></span>
        </nav>
        <div id="theme-control" class="site-header__theme" data-theme-preference="system">
          <svg aria-hidden="true" viewBox="0 0 80 36">
            <rect class="site-header__theme-plate" x="1" y="2" width="78" height="32" rx="1" />
            <path d="M8 11h16v11H8zM13 25h6M16 22v3" />
            <circle cx="40" cy="16.5" r="4" />
            <path d="M40 7v3M40 23v3M30.5 16.5h3M46.5 16.5h3M33.3 9.8l2.1 2.1M44.6 21.1l2.1 2.1M46.7 9.8l-2.1 2.1M35.4 21.1l-2.1 2.1M70.5 20.2A7 7 0 0 1 61.8 9.5 7 7 0 1 0 70.5 20.2z" />
            <path class="site-header__theme-detents" d="M28 7v19M52 7v19" />
            <rect class="site-header__theme-slider" x="4" y="5" width="24" height="23" rx="1" />
          </svg>
          <input id="theme-control-range" type="range" min="0" max="2" step="1" value="0" aria-label="Preferencia de tema" aria-valuetext="Sistema" />
        </div>
        <button id="site-menu-toggle" class="site-header__toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="Open navigation">
          <span aria-hidden="true">Menu</span>
        </button>
      </div>

    </nav>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector("#site-menu-toggle");
  const menu = document.querySelector("#site-navigation");
  const themeControl = document.querySelector("#theme-control");
  const themeRange = document.querySelector("#theme-control-range");
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  const applyTheme = (preference) => {
    const effective = preference === "system" ? (media.matches ? "dark" : "light") : preference;
    document.documentElement.dataset.themePreference = preference;
    document.documentElement.dataset.theme = effective;
    document.documentElement.style.colorScheme = effective;
  };

  if (themeControl instanceof HTMLElement && themeRange instanceof HTMLInputElement) {
    const preferences = ["system", "light", "dark"];
    const labels = { system: "Sistema", light: "Claro", dark: "Oscuro" };
    const updateThemeControl = (preference) => {
      themeControl.dataset.themePreference = preference;
      themeRange.value = String(preferences.indexOf(preference));
      themeRange.setAttribute("aria-valuetext", labels[preference]);
    };
    const setPreference = (preference) => {
      try { localStorage.setItem("rlp-theme", preference); } catch {}
      applyTheme(preference);
      updateThemeControl(preference);
    };

    updateThemeControl(document.documentElement.dataset.themePreference || "system");
    themeRange.addEventListener("input", () => setPreference(preferences[Number(themeRange.value)] || "system"));
    media.addEventListener("change", () => {
      if (document.documentElement.dataset.themePreference === "system") applyTheme("system");
    });
  }

  const closeMenu = () => {
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    menu.hidden = true;
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Open navigation");
  };

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      menu.hidden = isOpen;
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
    });

    menu.addEventListener("click", (event) => {
      if (event.target instanceof HTMLAnchorElement && window.innerWidth < 900) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 900) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--theme-line);
    background: var(--theme-surface);
    color: var(--theme-text);
  }

  .site-header__nav {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand,
  .site-header__link,
  .site-header__locale a,
  .site-header__toggle {
    font-family: var(--font-sans);
    font-weight: 500;
  }

  .site-header__brand {
    border-bottom: 2px solid transparent;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-decoration: none;
  }

  .site-header__toggle {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid var(--theme-text);
    background: transparent;
    color: inherit;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .site-header__utility {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .site-header__locale {
    display: grid;
    position: relative;
    width: 3rem;
    height: 2.125rem;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--theme-line);
    background: var(--theme-surface-raised);
  }

  .site-header__locale a {
    display: grid;
    place-items: center;
    color: var(--theme-text);
    font-size: 0.6875rem;
    font-weight: 700;
    text-decoration: none;
    z-index: 1;
  }

  .site-header__locale a + a { border-left: 1px solid var(--theme-line); }

  .site-header__locale a[aria-current="page"] {
    font-weight: 700;
  }

  .site-header__locale-marker {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: 17px;
    border: 1px solid var(--theme-accent);
    pointer-events: none;
  }

  .site-header__locale-marker[data-position="en"] {
    transform: translateX(23px);
  }

  .site-header__menu {
    position: absolute;
    right: 0;
    left: 0;
    top: 100%;
    border-bottom: 1px solid var(--theme-line);
    background: var(--theme-surface);
  }

  .site-header__menu[hidden] {
    display: none;
  }

  .site-header__links {
    display: grid;
    margin: 0;
    padding: 0.5rem 1.25rem 1rem;
    list-style: none;
  }

  .site-header__link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--theme-text);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .site-header__link:hover,
  .site-header__link.is-current {
    border-bottom-color: var(--color-rlp-cyan);
  }

  .site-header__link.is-current {
    color: var(--color-rlp-cyan);
    font-weight: 700;
  }

  .site-header__brand:focus-visible,
  .site-header__link:focus-visible,
  .site-header__locale a:focus-visible,
  .site-header__toggle:focus-visible,
  .site-header__theme:focus-within {
    outline: 2px solid var(--theme-accent);
    outline-offset: 2px;
  }

  .site-header__theme {
    display: grid;
    position: relative;
    width: 5rem;
    min-height: 2.75rem;
    place-items: center;
    color: inherit;
  }

  .site-header__theme svg {
    width: 4.75rem;
    height: 2rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-linejoin: miter;
    stroke-width: 1.25;
  }

  .site-header__theme input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .site-header__theme-plate {
    fill: var(--theme-surface-raised);
    stroke: var(--theme-line);
  }

  .site-header__theme-detents {
    stroke: var(--theme-line);
  }

  .site-header__theme-slider {
    fill: var(--theme-surface);
    stroke: var(--theme-text);
    transition: transform 120ms linear;
  }

  .site-header__theme[data-theme-preference="light"] .site-header__theme-slider { transform: translateX(24px); }

  .site-header__theme[data-theme-preference="dark"] .site-header__theme-slider { transform: translateX(48px); }

  @media (prefers-reduced-motion: reduce) {
    .site-header__theme-slider { transition: none; }
  }

  @media (min-width: 900px) {
    .site-header__toggle {
      display: none;
    }

    .site-header__menu,
    .site-header__menu[hidden] {
      position: static;
      display: block;
      border: 0;
    }

    .site-header__menu {
      display: block;
    }

    .site-header__primary {
      margin-left: auto;
    }

    .site-header__links {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0;
    }

    .site-header__link {
      min-height: 4.25rem;
      white-space: nowrap;
    }
  }
</style>
