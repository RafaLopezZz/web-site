---
import { certificates } from "../data/certificates";
import SkillIcon from "./SkillIcon.astro";
import { skillCategories } from "../data/skills";

const toId = (value: string) => value.toLowerCase().replaceAll("/", "-").replaceAll(" ", "-");
const base = import.meta.env.BASE_URL;
---

<section id="habilidades" class="scroll-mt-28 border-t border-white/10 pt-14 md:pt-16" aria-labelledby="habilidades-title">
  <div class="space-y-12">
    <div>
      <div class="mb-8 flex items-end justify-between gap-4">
        <h2 id="habilidades-title" class="font-display text-3xl font-bold md:text-5xl">Stack técnico</h2>
      </div>

      <p class="mb-8 max-w-3xl text-base leading-relaxed text-white/75 md:text-lg">
        Tecnologías con las que he trabajado en proyectos personales, formación y trabajo reciente.
      </p>

      <div class="grid gap-5 md:grid-cols-2">
        {
          skillCategories.map((category) => (
            <section aria-labelledby={`skills-${toId(category.title)}`} class="space-y-4 border border-white/10 bg-white/[0.02] p-6 md:p-7">
              <div class="space-y-3">
                <h3 id={`skills-${toId(category.title)}`} class="text-xs uppercase tracking-[0.24em] text-white/60">
                  {category.title}
                </h3>
                {category.description && (
                  <p class="max-w-2xl text-sm leading-relaxed text-white/70">{category.description}</p>
                )}
              </div>

              <ul class="flex flex-wrap gap-3">
                {
                  category.skills.map((skill) => (
                    <li class="inline-flex items-center gap-2 rounded-full border border-white/10 px-4 py-2 text-sm text-white/85 transition hover:border-accent/50 hover:text-white">
                      {skill.icon && <SkillIcon icon={skill.icon} />}
                      {skill.name}
                    </li>
                  ))
                }
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    <section aria-labelledby="certificados-title" class="space-y-6">
      <div class="flex items-end justify-between gap-4">
        <h3 id="certificados-title" class="font-display text-2xl font-bold md:text-3xl">Certificados</h3>
        <span class="text-xs uppercase tracking-[0.2em] text-white/60">{certificates.length} activos</span>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {
          certificates.map((certificate) => (
            <article class="space-y-4 border border-white/10 bg-white/[0.02] p-6">
              <div class="space-y-2">
                <p class="text-xs uppercase tracking-[0.18em] text-white/50">{certificate.date}</p>
                <h4 class="font-display text-2xl font-bold">{certificate.title}</h4>
                <p class="text-sm text-accent">{certificate.issuer}</p>
              </div>

              <a
                href={`${base}${certificate.file}`}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center text-sm uppercase tracking-[0.16em] text-white transition hover:text-accent"
              >
                Ver certificado
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>
