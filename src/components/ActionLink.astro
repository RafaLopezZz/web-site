---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary" | "text";
}

const { variant = "text", class: className, ...attributes } = Astro.props;
---

<a {...attributes} class:list={["action", `action--${variant}`, className]}>
  <slot />
</a>
