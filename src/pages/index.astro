---
import ActionLink from "../components/ActionLink.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title="Rafael López | Fullstack Developer"
  description="title = Rafael López | Desarrollador Fullstack"
  ,
  description="Desarrollo aplicaciones web y APIs con Java/Spring Boot, PHP/Laravel y PostgreSQL/MySQL, priorizando calidad, escalabilidad y mantenibilidad."
  ,
>
  <SiteHeader />

  <main id="main-content" class="home-shell">
    <div class="rlp-container">
      <section id="hero" class="home-hero" aria-labelledby="hero-title">
        <div id="hero-identity" class="home-hero__identity">
          <p class="home-hero__role">Software Developer</p>
          <h1 id="hero-title">Rafael López</h1>
          <p class="home-hero__territory">Backend · Datos · Sistemas</p>
          <p class="home-hero__copy">
            Desarrollo software para resolver problemas reales, con especial interés en backend, datos, automatización y sistemas conectados.
          </p>

          <div class="home-hero__actions">
            <ActionLink href={`${base}blog/`} variant="primary">Ver trabajo</ActionLink>
            <ActionLink
              href={`${base}cv/lopez-plana-rafael-2026.pdf`}
              download
              target="_blank"
              rel="noreferrer"
              variant="secondary"
            >
              Descargar CV
            </ActionLink>
          </div>
        </div>

        <aside id="cmd-identity" class="cmd-identity" aria-label="Technical identity">
          <div class="cmd-identity__titlebar">
            <span>C:\RLP\identity.exe</span>
            <span class="cmd-identity__controls" aria-hidden="true">_ □ ×</span>
          </div>
          <div class="cmd-identity__terminal">
            <p>C:\RLP&gt; whoami</p>
            <p>rlp-sys-admin</p>
            <p>C:\RLP&gt; <span class="cmd-identity__cursor">█</span></p>
          </div>
        </aside>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .home-shell {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .home-hero {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  .home-hero__identity {
    display: grid;
    align-content: center;
    gap: var(--space-5);
    min-width: 0;
  }

  .home-hero__role,
  .home-hero__territory {
    margin: 0;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-hero__role {
    color: var(--color-graphite);
    font-size: 0.875rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(3rem, 9vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }

  .home-hero__territory {
    font-size: 1rem;
  }

  .home-hero__copy {
    max-width: var(--reading-max);
    margin: 0;
    color: var(--color-graphite);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    line-height: 1.6;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .home-hero :global(.action--primary) {
    border-color: var(--color-ink);
  }

  .cmd-identity {
    align-self: center;
    min-width: 0;
    border: 2px solid #606568;
    box-shadow: inset 1px 1px #ffffff, inset -1px -1px #303437;
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .cmd-identity__titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.25rem 0.375rem;
    background: #b8b8b8;
    color: var(--color-ink);
    font-weight: 500;
  }

  .cmd-identity__controls {
    white-space: nowrap;
  }

  .cmd-identity__terminal {
    min-height: 10rem;
    padding: var(--space-5);
    background: var(--color-terminal);
  }

  .cmd-identity__terminal p {
    margin: 0;
  }

  .cmd-identity__cursor {
    color: var(--color-rlp-cyan);
  }

  @media (min-width: 768px) {
    .home-hero {
      grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr);
      align-items: center;
      min-height: calc(100vh - 4.25rem);
      padding-block: var(--space-9);
    }
  }
</style>
