---
import { Image } from "astro:assets";
import logo from "../assets/logo-cyan.svg";

const base = import.meta.env.BASE_URL;

const links = [
  { href: "#top", label: "Inicio" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#habilidades", label: "Stack" },
  { href: "#experiencia", label: "Experiencia" },
  { href: `${base}blog`, label: "Blog" },
  { href: "#contacto", label: "Contacto" },
  { href: "#cv", label: "CV", cta: true },
];
---

<header id="site-header" class="sticky top-0 z-50 transition-all duration-300">
  <div class="editorial-container">
    <nav
      class="mt-3 flex items-center justify-between gap-4 border border-white/10 bg-white/[0.03] px-4 py-2.5 shadow-[0_10px_30px_rgba(0,0,0,0.18)] transition-all duration-300 md:mt-4 md:gap-6 md:px-6 md:py-3.5"
      aria-label="Principal"
    >
      <a
        href={base}
        class="flex min-w-0 items-center gap-4 text-white"
        aria-label="Ir al inicio"
      >
        <Image
          src={logo}
          alt="Rafael López Plana"
          width={280}
          height={88}
          class="h-10 w-auto shrink-0 md:h-14 lg:h-16"
        />
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center border border-white/15 text-white md:hidden"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Abrir menú"
      >
        <span class="sr-only">Abrir menú</span>
        <span class="flex flex-col gap-1.5">
          <span class="block h-px w-5 bg-current"></span>
          <span class="block h-px w-5 bg-current"></span>
          <span class="block h-px w-5 bg-current"></span>
        </span>
      </button>

      <div
        id="nav-menu"
        class="nav-menu hidden md:block
         absolute left-0 top-[calc(100%+0.5rem)] w-full
         border border-white/10 bg-[#0B0C10]
         px-4 py-5 shadow-[0_18px_40px_rgba(0,0,0,0.3)]
         md:static md:w-auto md:border-0 md:bg-transparent md:p-0"
      >
        <ul
          class="flex flex-col gap-3 pt-2 text-sm uppercase tracking-[0.16em] text-white/75 md:flex-row md:items-center md:gap-6 md:pt-0"
        >
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href.startsWith("#") ? `${base}${link.href}` : link.href}
                  class:list={[
                    "nav-link transition hover:text-accent",
                    link.cta && "inline-flex items-center justify-center border border-white/15 px-3 py-2 text-white hover:border-accent"
                  ]}
                  data-section-link={
                    link.href.startsWith("#") ? true : undefined
                  }
                  data-blog-link={link.label === "Blog" ? true : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  const header = document.querySelector("#site-header");
  const menu = document.querySelector("#nav-menu");
  const toggle = document.querySelector("#nav-toggle");
  const links = Array.from(document.querySelectorAll("[data-section-link]"));
  const blogLink = document.querySelector("[data-blog-link]");
  const path = window.location.pathname;
  const homePath = `${window.location.origin}${document.querySelector('a[aria-label="Ir al inicio"]')?.getAttribute("href") ?? "/"}`;
  const sections = links
    .map((link) => {
      const href = link.getAttribute("href");
      const hash = href?.includes("#") ? `#${href.split("#")[1]}` : href;
      return hash ? document.querySelector(hash) : null;
    })
    .filter(Boolean);

  const setScrolledState = () => {
    if (!header) return;
    header.dataset.scrolled = String(window.scrollY > 16);
  };

  const closeMenu = () => {
    if (
      !(menu instanceof HTMLElement) ||
      !(toggle instanceof HTMLButtonElement)
    )
      return;
    menu.classList.add("hidden");
    toggle.setAttribute("aria-expanded", "false");
    toggle.setAttribute("aria-label", "Abrir menú");
  };

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      menu.classList.toggle("hidden", isOpen);
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
    });

    links.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 768) closeMenu();
      });
    });
  }

  if (window.location.href.startsWith(homePath) && sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            const href = link.getAttribute("href");
            const hash = href?.includes("#") ? `#${href.split("#")[1]}` : href;
            const isActive = hash === `#${entry.target.id}`;
            link.classList.toggle("text-accent", isActive);
            link.classList.toggle("text-white/70", !isActive);
            if (isActive) {
              link.setAttribute("aria-current", "page");
            } else {
              link.removeAttribute("aria-current");
            }
          });
        });
      },
      { rootMargin: "-35% 0px -45% 0px", threshold: 0.2 },
    );

    sections.forEach((section) => observer.observe(section));
  }

  if (blogLink instanceof HTMLAnchorElement && path.includes("/blog")) {
    blogLink.classList.add("text-accent");
    blogLink.classList.remove("text-white/70");
    blogLink.setAttribute("aria-current", "page");
  }

  setScrolledState();
  window.addEventListener("scroll", setScrolledState, { passive: true });
  window.addEventListener("resize", () => {
    if (
      window.innerWidth >= 768 &&
      menu instanceof HTMLElement &&
      toggle instanceof HTMLButtonElement
    ) {
      menu.classList.remove("hidden");
      toggle.setAttribute("aria-expanded", "false");
    } else if (window.innerWidth < 768) {
      closeMenu();
    }
  });
</script>
