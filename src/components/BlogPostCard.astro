---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<article class="blog-post-card group overflow-hidden transition">
  <a href={`${base}blog/${post.id}/`} class="block" aria-label={`Leer ${post.data.title}`}>
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt}
      width={1440}
      height={900}
      class="h-56 w-full object-cover opacity-85 transition duration-300 group-hover:opacity-100"
    />
  </a>

  <div class="space-y-4 p-6">
    <div class="flex items-center justify-between gap-4">
      <time class="text-xs uppercase tracking-[0.18em]">
        {post.data.date.toLocaleDateString("es-ES", { day: "2-digit", month: "short", year: "numeric" })}
      </time>
      <span class="blog-post-card__kind text-xs uppercase tracking-[0.18em]">Notas</span>
    </div>

    <div class="space-y-3">
      <h2 class="font-display text-2xl font-bold">
        <a href={`${base}blog/${post.id}/`} class="transition">{post.data.title}</a>
      </h2>
      <p class="text-sm leading-relaxed">{post.data.excerpt}</p>
    </div>

    <ul class="flex flex-wrap gap-2">
      {post.data.tags.map((tag) => <li class="blog-post-card__tag text-xs uppercase tracking-[0.14em]">{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .blog-post-card { border: 1px solid var(--theme-line); background: var(--theme-surface-raised); }
  .blog-post-card:hover { border-color: var(--theme-accent); }
  .blog-post-card time, .blog-post-card p, .blog-post-card__kind { color: var(--theme-text-muted); }
  .blog-post-card h2 a:hover, .blog-post-card__tag { color: var(--theme-accent); }
</style>
