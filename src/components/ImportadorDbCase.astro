---
import WorkCase from "./WorkCase.astro";
import { importadorDbCase } from "../data/importador-db-case";

const { locale } = Astro.props as { locale: "es" | "en" };
const copy = importadorDbCase[locale];
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<WorkCase
  locale={locale}
  caseId="importador-db"
  copy={copy}
  sourceHref="https://github.com/RafaLopezZz/importador-db"
  blogHref={`${base}blog/desarrollo-importador-db/`}
/>
