---
import type { TimelineItemEducation } from "../data/types";

interface Props {
  id: string;
  title: string;
  items: TimelineItemEducation[];
}

const { id, title, items } = Astro.props;
---

<section id={id} class="scroll-mt-28 border-t border-white/10 pt-14 md:pt-16" aria-labelledby={`${id}-title`}>
  <div class="mb-10 flex items-end justify-between gap-4">
    <h2 id={`${id}-title`} class="font-display text-3xl font-bold md:text-5xl">{title}</h2>
  </div>

  <div class="timeline">
    {
      items.map((item) => (
        <article class="timeline-item">
          <span class="timeline-dot" aria-hidden="true" />
          <p class="timeline-period">{item.period}</p>
          <div class="space-y-2">
            <h3 class="font-display text-2xl font-bold">{item.degree}</h3>
            <p class="text-sm text-accent">{item.institution}</p>
            {item.marks && <p class="text-sm text-accent">{item.marks}</p>}
            {item.summary && (
              <p class="max-w-3xl text-sm leading-relaxed text-white/75">{item.summary}</p>
            )}
            <ul class="max-w-3xl space-y-2 text-sm leading-relaxed text-white/80">
              {item.highlights.map((highlight) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
