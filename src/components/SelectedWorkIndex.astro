---
import ActionLink from "./ActionLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import Surface from "./Surface.astro";
import { selectedWork } from "../data/selected-work";

interface Props {
  locale: "es" | "en";
  kind: "work" | "production";
}

const { locale, kind } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isWork = kind === "work";
const copy = locale === "en"
  ? {
      title: isWork ? "Work | Rafael López" : "Production | Rafael López",
      description: isWork ? "Selected software work by Rafael López." : "Production cases by Rafael López.",
      eyebrow: isWork ? "RLP / WORK" : "RLP / PROD",
      heading: isWork ? "Work" : "Production",
      intro: isWork ? "Selected software work." : "Accountable production cases.",
    }
  : {
      title: isWork ? "Trabajo | Rafael López" : "Producción | Rafael López",
      description: isWork ? "Trabajo de software seleccionado de Rafael López." : "Casos de producción de Rafael López.",
      eyebrow: isWork ? "RLP / WORK" : "RLP / PROD",
      heading: isWork ? "Trabajo" : "Producción",
      intro: isWork ? "Trabajo de software seleccionado." : "Casos de producción verificables.",
    };
const items = isWork ? selectedWork[locale].workItems : selectedWork[locale].productionItems;
---

<BaseLayout title={copy.title} description={copy.description} lang={locale}>
  <SiteHeader locale={locale} />

  <main id="main-content" class="selected-index-shell">
    <section class="selected-index rlp-container" data-selected-work-index aria-labelledby="selected-index-title">
      <header class="selected-index__header">
        <p>{copy.eyebrow}</p>
        <h1 id="selected-index-title">{copy.heading}</h1>
        <p>{copy.intro}</p>
      </header>

      <div class="selected-index__records">
        {items.map((item) => (
          <Surface variant={isWork ? "artifact" : "dossier"} class="selected-index__record">
            <p class="selected-index__id">{copy.eyebrow} / {item.id.slice(-3)}</p>
            <h2>{item.title}</h2>
            <p>{item.summary}</p>
            <p class="selected-index__tech">{item.techHighlights}</p>
            {item.action && (
              <ActionLink href={item.action.external ? item.action.href : `${base}${item.action.href}`} target={item.action.external ? "_blank" : undefined} rel={item.action.external ? "noreferrer" : undefined}>{item.action.label}</ActionLink>
            )}
          </Surface>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .selected-index-shell { background: var(--theme-canvas); color: var(--theme-text); }
  .selected-index { display: grid; gap: var(--space-7); padding-block: var(--space-8); }
  .selected-index__header { display: grid; gap: var(--space-3); max-width: var(--reading-max); }
  .selected-index__header p { margin: 0; color: var(--theme-text-muted); line-height: 1.6; }
  .selected-index__header p:first-child, .selected-index__id, .selected-index__tech { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; }
  .selected-index__header h1, .selected-index__record h2 { margin: 0; font-family: var(--font-sans); line-height: 1.05; }
  .selected-index__header h1 { font-size: clamp(2.5rem, 6vw, 5rem); }
  .selected-index__records { display: grid; border-top: 1px solid var(--theme-line); }
  .selected-index__record { display: grid; gap: var(--space-4); padding: var(--space-6) 0; border-inline: 0; border-bottom: 1px solid var(--theme-line); }
  .selected-index__record h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .selected-index__record > p { max-width: var(--reading-max); margin: 0; color: var(--theme-text-muted); line-height: 1.6; }
  .selected-index__record > .selected-index__id { color: var(--theme-accent); }
  .selected-index__record :global(.action) { justify-self: start; }
  @media (min-width: 768px) {
    .selected-index { padding-block: var(--space-9); }
    .selected-index__record { grid-template-columns: minmax(10rem, 0.45fr) minmax(0, 1.55fr); column-gap: var(--space-7); }
    .selected-index__record > :not(.selected-index__id) { grid-column: 2; }
  }
</style>
