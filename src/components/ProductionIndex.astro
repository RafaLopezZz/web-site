---
import ProductionDossier from "./ProductionDossier.astro";
import TerritoryIndex from "./TerritoryIndex.astro";
import { selectedWork } from "../data/selected-work";

interface Props {
  locale: "es" | "en";
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const productionItems = selectedWork[locale].productionItems.map((item) => item.action && !item.action.external
  ? { ...item, action: { ...item.action, href: `${base}${item.action.href}` } }
  : item);
const copy = locale === "en"
  ? {
      title: "Production | Rafael López",
      description: "Production cases by Rafael López.",
      eyebrow: "RLP / PROD",
      heading: "Production",
      intro: "Accountable production cases.",
    }
  : {
      title: "Producción | Rafael López",
      description: "Casos de producción de Rafael López.",
      eyebrow: "RLP / PROD",
      heading: "Producción",
      intro: "Casos de producción verificables.",
    };
---

<TerritoryIndex locale={locale} territory="production" {...copy}>
  {productionItems.map((item) => <ProductionDossier locale={locale} item={item} eyebrow={copy.eyebrow} />)}
</TerritoryIndex>
