---
import ProductionCase from "./ProductionCase.astro";
import { aguilasFcCase } from "../data/aguilas-fc-case";

const { locale } = Astro.props as { locale: "es" | "en" };
---

<ProductionCase
  locale={locale}
  caseId="aguilas-fc"
  copy={aguilasFcCase[locale]}
  publicSiteHref="https://aguilasfc.es/"
/>
